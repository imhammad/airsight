# Copy to .env and fill in real values. Never commit .env.
PURPLEAIR_KEY=
OPENAQ_KEY=
AIRNOW_KEY=

# MLflow tracking server (the mlflow service in docker-compose.yml)
# MLFLOW_TRACKING_URI=http://localhost:5001

# Public API requests per client IP per minute (ADR 0008)
# RATE_LIMIT_PER_MINUTE=60

# Logs are one JSON object per line (ADR 0013); text is easier to read in a terminal
# LOG_FORMAT=json
