# Production secrets for docker-compose.prod.yml (ADR 0014). Copy to .env.prod and fill in.
# Never commit .env.prod. The API keys themselves stay in .env, shared with development.

# Database password for the airsight user. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Grafana admin password (viewing the dashboards needs no login)
GRAFANA_ADMIN_PASSWORD=

# Where the nightly database backups go (issue #167): a folder in iCloud Drive, so they leave
# the Mac. Create the folder first. The quotes are needed because of the spaces.
BACKUP_DIR="/Users/hammadhassan/Library/Mobile Documents/com~apple~CloudDocs/AirSight Backups"
# How many daily backups to keep
BACKUP_KEEP=14
